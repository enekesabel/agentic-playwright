 # Shell scripts and Dockerfiles must use LF — CRLF breaks bash shebangs and Docker RUN directives in Linux containers
*.sh text eol=lf
Dockerfile text eol=lf

# Generated by scripts/build-mirrors.mjs from CLAUDE.md and .claude/skills/ (see CLAUDE.md "Editing the Rule Trees").
# GitHub collapses these in pull-request diffs and leaves them out of the diff stats.
.cursor/** linguist-generated=true
.github/instructions/** linguist-generated=true
.github/copilot-instructions.md linguist-generated=true
